{
  "name": "xorgxx/neox-qrcode-bundle",
  "description": "Reusable Symfony UX QR Code component with Stimulus, custom SVG rendering, API and secure payload support.",
  "type": "symfony-bundle",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "bacon/bacon-qr-code": "^3.1",
    "symfony/framework-bundle": "^7.4 || ^8.0",
    "symfony/twig-bundle": "^7.4 || ^8.0",
    "symfony/ux-twig-component": "^2.28",
    "symfony/cache-contracts": "^3.5",
    "twig/twig": "^3.15"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "symfony/phpunit-bridge": "^7.4 || ^8.0",
    "symfony/rate-limiter": "^7.4 || ^8.0"
  },
  "suggest": {
    "ext-imagick": "Required for PNG export.",
    "ext-sodium": "Required for encrypted QR payloads.",
    "symfony/rate-limiter": "Required for API rate limiting."
  },
  "autoload": {
    "psr-4": {
      "Xorgxx\\NeoxQrCodeBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Xorgxx\\NeoxQrCodeBundle\\Tests\\": "tests/"
    }
  },
  "extra": {
    "symfony": {
      "allow-contrib": true
    }
  }
}
